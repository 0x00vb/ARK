+fn request_coverage(
+    records: &[crate::record::RequestRecord],
+    expected: &BTreeMap<String, u32>,
+) -> bool {
+    let mut successful = BTreeMap::new();
+    for record in records.iter().filter(|r| r.error.is_none()) {
+        *successful.entry(record.model.clone()).or_insert(0) += 1;
+    }
+    &successful == expected
