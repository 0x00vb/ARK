{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiark.dev/protocol/v1/bootstrap.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocols", "runtimeVersion"],
  "properties": {
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["major", "latestMinor"],
        "properties": {
          "major": { "type": "integer", "minimum": 1 },
          "latestMinor": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "updateUrl": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 }
  }
}
